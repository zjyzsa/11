{
  "name": "dsh-skill-manager",
  "version": "1.0.0",
  "description": "Turn skills on or off and limit a skill to selected workspaces, from a button in the Session toolbar.",
  "type": "module",
  "license": "MIT",
  "author": "zjyzsa",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjyzsa/11.git"
  },
  "homepage": "https://github.com/zjyzsa/11#readme",
  "bugs": {
    "url": "https://github.com/zjyzsa/11/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
